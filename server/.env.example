PORT=5000

# MongoDB — Option 1: full URI (takes priority)
MONGO_URI=

# Option 2: compose URI from parts
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=toykart
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_SOURCE=admin

# JWT
JWT_SECRET=replace_with_a_secure_secret
JWT_ACCESS_EXPIRES=30d

# App URLs
CLIENT_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:5000

# Email — Gmail App Password (recommended for local testing)
GMAIL_USER=shamimahmed4929@gmail.com
GMAIL_APP_PASSWORD=naxiamvowuabjulh
EMAIL_FROM=ToyKart <your.email@gmail.com>
# Customer notifications are blocked for sender + these emails (admin inbox)
NOTIFY_BLOCK_EMAILS=your.admin@gmail.com

# Or generic SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_app_password

# Password reset OTP lifetime (minutes)
OTP_EXPIRE_MINUTES=10

# SSLCommerz (payments)
SSLCZ_STORE_ID=your_sslcommerz_store_id
SSLCZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCZ_IS_LIVE=false
