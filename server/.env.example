PORT=5000
# Option 1: full URI (takes priority)
MONGO_URI=

# Option 2: compose URI from Docker/local parts
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=toykart
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_SOURCE=admin

JWT_SECRET=replace_with_a_secure_secret
CLIENT_URL=http://localhost:5173
SSLCZ_STORE_ID=your_sslcommerz_store_id
SSLCZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCZ_IS_LIVE=false
SERVER_BASE_URL=http://localhost:5000
# Public base URL for uploaded images (defaults to http://localhost:PORT)
# SERVER_PUBLIC_URL=https://api.yourdomain.com
