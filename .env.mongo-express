# Copy to .env.mongo-express and adjust if needed.
# For MongoDB with auth:
# ME_CONFIG_MONGODB_URL=mongodb://root:secret@host.docker.internal:27017/?authSource=admin
# For MongoDB without auth:
ME_CONFIG_MONGODB_URL=mongodb://host.docker.internal:27017/

# Web login for mongo-express UI
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123

# Optional editor theme inside mongo-express
ME_CONFIG_OPTIONS_EDITORTHEME=dracula
